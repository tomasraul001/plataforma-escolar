# Copie este ficheiro para .env e substitua os valores.
#   cp .env.example .env
#
# O .env esta no .gitignore e NUNCA deve ser commitado.

# ---------------------------------------------------------------------------
# Obrigatorias
# ---------------------------------------------------------------------------

# DSN do PostgreSQL. Sem esta variavel o `prisma generate` falha em build.
DATABASE_URL=postgresql://utilizador:palavra_passe@localhost:5432/plataforma_escolar?schema=public

# Chave de assinatura do JWT (HS256). Sem ela nenhum request autenticado
# passa. Gere uma longa e aleatoria, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=cole_aqui_uma_frase_secreta_longa_e_aleatoria

# ---------------------------------------------------------------------------
# Chaves de acesso (registo de utilizadores)
# ---------------------------------------------------------------------------
# Sao 4 segredos distintos: o registo compara a chave submetida com estas para
# decidir a role. Sao APENAS 4 valores distintos entre si, nao 4 strings
# unicas — se repetir uma, duas roles ficam com a mesma chave.
# Sem qualquer uma delas o POST /register devolve 500.
#
# Formandos usam um link partilhado, por isso a exposicao da
# FORMANDO_KEY e aceitavel. As restantes protegem areas restritas.
COORDENADOR_KEY=chave_de_acesso_do_coordenador
FORMADOR_KEY=chave_de_acesso_do_formador
FORMANDO_KEY=chave_de_acesso_do_formando
SECRETARIA_KEY=chave_de_acesso_da_secretaria

# ---------------------------------------------------------------------------
# Opcionais (têm default)
# ---------------------------------------------------------------------------
# Porta do servidor (default 3000)
# PORT=3000

# URL do frontend, para a allowlist de CORS. Sem valor, so ha
# http://localhost:5173 e https://centro-apec.vercel.app.
# FRONTEND_URL=https://plataforma-escolar-production-9535.up.railway.app

# Railway injecta isto automaticamente. So interessa se usares um dominio
# custom: o valor tem de ser so o dominio, sem https:// e sem barra final.
# RAILWAY_PUBLIC_DOMAIN=plataforma-escolar-production-9535.up.railway.app

# Confia no X-Forwarded-For (preciso atras de proxy/load balancer para o
# rate limit ver o IP real). true = 1 hop, false = nao confia, inteiro =
# nº de hops. Sem valor: 1 se os markers RAILWAY_* existirem, senao false.
# Em deploy direto (sem proxy) mantem indefinido/false — senao qualquer
# cliente falsifica o IP e contorna o rate limit.
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Scripts de seed (nao usados pela API)
# ---------------------------------------------------------------------------
# Password inicial dos utilizadores criados pelo `npm run seed`
# SEED_PASSWORD=Mudar@123

# Quantos formando o seed cria por turma
# SEED_STUDENTS_PER_CLASS=12